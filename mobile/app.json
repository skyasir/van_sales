{
  "expo": {
    "name": "Van Sales",
    "slug": "van-sales",
    "scheme": "vansales",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ae.gulfpantry.vansales",
      "infoPlist": {
        "NSCameraUsageDescription": "Scanning barcodes is how items are added to an invoice and confirmed on delivery.",
        "NSLocationWhenInUseUsageDescription": "Invoices and collections are stamped with where they were raised, so a sale can be traced back to a stop."
      }
    },
    "android": {
      "package": "ae.gulfpantry.vansales",
      "adaptiveIcon": {
        "backgroundColor": "#000104",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN"
      ]
    },
    "web": {
"output": "static",     
 "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Scanning barcodes is how items are added to an invoice and confirmed on delivery.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Invoices and collections are stamped with where they were raised, so a sale can be traced back to a stop."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f80747f2-c806-436d-874a-376c788b7ff8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/f80747f2-c806-436d-874a-376c788b7ff8"
    },
    "backgroundColor": "#000104"
  }
}
